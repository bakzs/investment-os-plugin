#!/usr/bin/env bash
set -euo pipefail

staged_files="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if [[ -n "$staged_files" ]]; then
  filtered="$(printf '%s\n' "$staged_files" | { grep -vE '^defaults/etf_weights\.json$' || true; })"
  forbidden="$(printf '%s\n' "$filtered" | { grep -E '(\.(csv|pdf|xlsx|xls|pem|key)$|(^|/)(portfolio\.json|profile\.yaml|catalysts\.yaml|etf_weights\.json|market_cache\.json|edgar_cache\.json|edgar_latest\.json|history_cache\.json|pa_performance\.json|test_log\.jsonl|alerts_log\.jsonl|intel_history\.jsonl|privacy-denylist\.json)$|^(dossiers|themes|macro|theses|notes|local|scratch)/)' || true; })"
  if [[ -n "$forbidden" ]]; then
    echo "ERROR: Refusing to commit personal/private data file(s):" >&2
    printf '%s\n' "$forbidden" >&2
    echo "Store private exports and research dossiers strictly inside \${PLUGIN_DATA}." >&2
    exit 1
  fi
fi

npm run privacy-check
